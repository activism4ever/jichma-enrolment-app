APP_NAME="JICHMA Enrolment"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
APP_URL=https://enrolment.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# argon2id is required by policy. See config/hashing.php.
HASH_DRIVER=argon2id
ARGON2_MEMORY=65536
ARGON2_THREADS=2
ARGON2_TIME=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=enrolment
DB_USERNAME=enrolment
DB_PASSWORD=

# Database-backed queue: works on shared hosting where no supervisor exists.
# Requires the cron entry documented in deployment/DEPLOYMENT-GUIDE.md.
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

SESSION_DRIVER=database
# Minutes of inactivity before the session is discarded.
SESSION_LIFETIME=30
# Idle timeout enforced in middleware as well, so a stolen session cookie stops
# working even if the cookie itself outlives its database row.
SESSION_IDLE_MINUTES=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Seeder bootstrap administrator. Used only by `php artisan db:seed`.
# Change the password immediately after the first sign-in.
ADMIN_EMAIL=admin@example.com
# Quote this if it contains a #, otherwise .env treats the rest as a comment.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Exports
# ---------------------------------------------------------------------------
# How long a finished export may be downloaded before its link stops working.
# The file itself is removed by `php artisan exports:prune`; see
# deployment/DEPLOYMENT-GUIDE.md for the cron entry.
EXPORT_RETAIN_HOURS=24
# Named queue so a slow export cannot delay anything else.
EXPORT_QUEUE=exports
# Refuses a photo bundle larger than this many rows rather than building a
# file no shared host could produce.
EXPORT_MAX_PHOTO_BUNDLE_ROWS=5000
